{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":disableRateLimiting",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Asia/Tokyo",
  "dependencyDashboard": false,
  "automerge": true,
  "platformAutomerge": true,
  "platformCommit": "enabled",
  "assignees": ["book000"],
  "configMigration": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "postUpdateOptions": ["gomodTidy"],
  "regexManagers": [
    {
      "fileMatch": ["(^|/)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
      "matchStrings": ["FROM node:(?<currentValue>.*?)-.*\\n"],
      "depNameTemplate": "node",
      "datasourceTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "fileMatch": ["(^|/)Dockerfile$", "(^|/)Dockerfile\\.[^/]*$"],
      "matchStrings": [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\sENV .*?_VERSION=(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["book000/templates"],
      "pinDigests": false
    },
    {
      "matchPackageNames": ["node"],
      "matchManagers": ["dockerfile"],
      "enabled": false
    },
    {
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "description": "Group node datasource updates and pin them to one version so that FROM node (Dockerfile), .node-version and engines.node (package.json) stay in sync",
      "matchPackageNames": ["node"],
      "matchDatasources": ["node"],
      "groupName": "node",
      "versioning": "node",
      "rangeStrategy": "pin"
    },
    {
      "groupName": "fastify",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["fastify", "fastify-raw-body", "@fastify/**"]
    },
    {
      "description": "TypeScript 7 does not provide tsc internal APIs (such as ts.Extension.Cjs) yet, and typescript-eslint crashes in startup code that depends on them, so major typescript updates are temporarily blocked. The check-typescript-eslint-ts7-support workflow detects when typescript-eslint adds support; remove this rule once support is confirmed",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": ["!/^@book000\\//"],
      "stabilityDays": 3
    }
  ]
}
